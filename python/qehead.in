&control
 calculation = 'scf'
 pseudo_dir = './pseudo'
 outdir = './tmp'
/
&system
 ibrav = 1
 celldm(1) = 15.2826
 nat = 32
 ntyp = 2
 ecutwfc = 60.0
 occupations = 'smearing'
 smearing = 'm-p'
 degauss = 0.01
 assume_isolated = 'mp'
/
&electrons
 mixing_beta = 0.7
 conv_thr = 1.0d-8
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
 Al 26.98 Al.pbe-n-rrkjus_psl.1.0.0.UPF
 Si 28.085 Si.pbe-n-rrkjus_psl.1.0.0.UPF
K_POINTS {automatic}
4 4 4 0 0 0
ATOMIC_POSITIONS {alat}
